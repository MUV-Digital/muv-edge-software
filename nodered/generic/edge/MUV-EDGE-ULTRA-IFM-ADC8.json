        {
            "id": "yj1eg8ofslvmgdd9",
            "type": "function",
            "z": "oxyimcfip6nzb353",
            "name": "parse ADC value",
            "func": "// Raw ADC counts -> engineering value\n//   signal   : \"4-20mA\" (default) | \"0-10V\"\n//   min/max  : engineering range of the sensor\n//   rawMin / rawMax / faultRaw : optional calibration overrides\nconst dp = msg.dataPoint;\nconst txt = (msg.payload || \"\").toString().trim();\nif (txt === \"\") {\n    return null; // failures are reported via the return code output\n}\nconst raw = parseInt(txt, 10);\nif (isNaN(raw)) {\n    node.error(`ADC ${dp.id}: unexpected output \"${txt}\"`, msg);\n    return null;\n}\n\nconst FULL_SCALE = 2047; // 11-bit single-ended (ADS1015)\nconst signal = dp.signal || \"4-20mA\";\n\nlet rawMin, rawMax, faultRaw = null;\nif (signal === \"0-10V\") {\n    rawMin = 0;\n    rawMax = FULL_SCALE;\n} else {\n    rawMin = FULL_SCALE * 4 / 20;     // ~409 at 4 mA\n    rawMax = FULL_SCALE;              // 20 mA\n    faultRaw = FULL_SCALE * 3.6 / 20; // ~368 = 3.6 mA (NAMUR NE43)\n}\nif (typeof dp.rawMin === \"number\") rawMin = dp.rawMin;\nif (typeof dp.rawMax === \"number\") rawMax = dp.rawMax;\nif (typeof dp.faultRaw === \"number\") faultRaw = dp.faultRaw;\n\nconst engMin = typeof dp.min === \"number\" ? dp.min : 0;\nconst engMax = typeof dp.max === \"number\" ? dp.max : 100;\n\nlet value;\nif (faultRaw !== null && raw < faultRaw) {\n    value = -99; // wire break / sensor fault\n} else {\n    value = engMin + ((raw - rawMin) / (rawMax - rawMin)) * (engMax - engMin);\n    value = Math.min(engMax, Math.max(engMin, value));\n}\n\nmsg.raw = raw;\nmsg.payload = { [dp.id]: value };\nnode.send(msg);\n\n// optional error flag, only if the image defines \"<id>_ERROR\" as virtual protocol\nconst errDp = (flow.get(\"bridge.image.protocols\") || [])\n    .find(p => p.id === dp.id + \"_ERROR\" && p.type === \"virtual\");\nif (errDp) {\n    node.send({ name: errDp.id, dataPoint: errDp, payload: { [errDp.id]: value === -99 } });\n}\nnode.done();",
