            "type": "function",
            "z": "oxyimcfip6nzb353",
            "name": "check return code",
            "func": "// exec return code output: anything other than 0 is a read failure\nif (msg.payload && msg.payload.code !== 0) {\n    node.error(`ADC read failed for ${msg.name} (${msg.adcPath}): rc=${msg.payload.code}`, msg);\n}\nreturn null;\n",
