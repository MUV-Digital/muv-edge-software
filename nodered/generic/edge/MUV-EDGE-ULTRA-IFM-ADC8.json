        {
            "id": "3po7mx5ghyfk1cib",
            "type": "function",
            "z": "oxyimcfip6nzb353",
            "name": "build ADC reads",
            "func": "// One read per ADC data point.\n// Data point convention (bridge.image.protocols):\n//   address : IFM-ADC8 channel 0..7 (0-3 = first block, 4-7 = second block)\n//   path    : optional full sysfs path, overrides the derived one\nconst SLOT = (flow.get(\"bridge.image.controller\") || {}).slot || \"A\";\n// Symlink naming: /dev/iotdin/extension/ADC8-<slot>-<block>\nconst SAFE_PATH = /^\\/[A-Za-z0-9_\\/.:\\-]+$/;\n\nconst points = (flow.get(\"bridge.image.protocols\") || [])\n    .filter(dp => dp.type !== \"virtual\" && dp.type !== \"calculated\");\n\nfor (const dp of points) {\n    let path = dp.path;\n    if (!path) {\n        const ch = Number(dp.address);\n        if (!Number.isInteger(ch) || ch < 0 || ch > 7) {\n            node.warn(`Data point ${dp.id}: invalid ADC channel \"${dp.address}\"`);\n            continue;\n        }\n        const block = ch < 4 ? 1 : 2;\n        path = `/dev/iotdin/extension/ADC8-${SLOT}-${block}/in_voltage${ch % 4}_raw`;    }\n    if (!SAFE_PATH.test(path)) {\n        node.warn(`Data point ${dp.id}: rejected path \"${path}\"`);\n        continue;\n    }\n    node.send({ topic: dp.id, name: dp.id, dataPoint: dp, adcPath: path, payload: path });\n}\nnode.done();\n",
