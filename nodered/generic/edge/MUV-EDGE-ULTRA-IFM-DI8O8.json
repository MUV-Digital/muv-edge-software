        {
            "id": "9s8g63dvmp2orae1",
            "type": "function",
            "z": "zmvla7av3iohil20",
            "name": "command result",
            "func": "// gpioset return code -> command response (+ metric update on success)\nconst ok = msg.payload && msg.payload.code === 0;\nconst response = msg.response;\nresponse.status = ok ? \"OK\" : \"ERROR\";\nresponse.error = ok ? \"\" : \"ERROR_BRIDGE_COMMAND_EXECUTION\";\n\nconst responseMsg = { payload: { response: response, topic: msg.responseTopic } };\nlet metricMsg = null;\n\nif (ok) {\n    metricMsg = {\n        payload: { [msg.dataPoint.id]: msg.targetState },\n        dataPoint: msg.dataPoint,\n        name: msg.name\n    };\n} else {\n    node.warn(`gpioset failed for ${msg.name} (${msg.gpioArgs}): rc=${msg.payload && msg.payload.code}`);\n}\nreturn [responseMsg, metricMsg];\n",
            "outputs": 2,
            "timeout": 0,
            "noerr": 0,
            "initialize": "",
            "finalize": "",
            "libs": [],
            "x": 1460,
