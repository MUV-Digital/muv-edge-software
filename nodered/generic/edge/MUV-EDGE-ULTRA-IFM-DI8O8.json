            "type": "exec",
            "z": "zmvla7av3iohil20",
            "command": "gpioset",
            "addpay": "payload",
            "append": "",
            "useSpawn": "false",
            "timer": "5",
            "winHide": false,
            "oldrc": false,
            "name": "gpioset",
            "x": 1260,
