        {
            "id": "quo5ob5qqwqenfkv",
            "type": "function",
            "z": "zmvla7av3iohil20",
            "name": "parse DI state",
            "func": "// gpioget stdout \"1 0 1 ...\" -> one metric message per input (same order as requested lines)\nconst txt = (msg.payload || \"\").toString().trim();\nif (txt === \"\") {\n    return null; // failures are reported via the return code output\n}\nconst values = txt.split(/\\s+/);\nif (values.length !== msg.points.length || values.some(v => v !== \"0\" && v !== \"1\")) {\n    node.error(`${msg.name}: unexpected gpioget output \"${txt}\" for lines ${msg.points.map(p => p.line).join(\",\")}`, msg);\n    return null;\n}\n\nmsg.points.forEach((p, i) => {\n    let state = values[i] === \"1\";\n    if (p.dataPoint.invert) state = !state;\n    node.send({ name: p.dataPoint.id, dataPoint: p.dataPoint, payload: { [p.dataPoint.id]: state } });\n});\nnode.done();\n",
