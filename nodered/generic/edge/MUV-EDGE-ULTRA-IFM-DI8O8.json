        {
            "id": "t1ujkklj0ir66ahh",
            "type": "function",
            "z": "zmvla7av3iohil20",
            "name": "prepare DO command",
            "func": "// Command -> gpioset arguments. Output 1: gpioset, output 2: immediate error response\nconst command = (msg.payload && msg.payload.command) || {};\nconst response = (msg.payload && msg.payload.response) || {};\nconst responseTopic = flow.get(\"bridge\").uplink.endpoint.url + \"/command/response\";\n\nfunction fail(code, text) {\n    node.warn(text);\n    response.status = \"ERROR\";\n    response.error = code;\n    return [null, { payload: { response: response, topic: responseTopic } }];\n}\n\nconst commandDef = (flow.get(\"bridge.image.commands\") || []).find(c => c.id === command.id);\nconst dp = commandDef ? (flow.get(\"bridge.image.protocols\") || []).find(p => p.id === commandDef.protocolId) : undefined;\nif (!commandDef || !dp) {\n    return fail(\"ERROR_BRIDGE_COMMAND_CONFIG\", `Unknown command \"${command.id}\"`);\n}\nif (String(dp.io || \"DI\").toUpperCase() !== \"DO\") {\n    return fail(\"ERROR_BRIDGE_COMMAND_CONFIG\", `Data point ${dp.id} is not a digital output`);\n}\n\nconst slot = String(dp.slot || (flow.get(\"bridge.image.controller\") || {}).slot || \"A\").toUpperCase();\nconst pin = Number(dp.address);\nconst DO_LINE_OFFSET = Number(env.get(\"DO_LINE_OFFSET\") ?? 8);\nconst GPIOD_V2 = env.get(\"GPIOD_V2\") === true;\nconst line = dp.line !== undefined ? Number(dp.line) : pin + DO_LINE_OFFSET;\nif (!/^[A-H]$/.test(slot) || !Number.isInteger(pin) || pin < 0 || pin > 7 || !Number.isInteger(line) || line < 0 || line > 63) {\n    return fail(\"ERROR_BRIDGE_COMMAND_CONFIG\", `Data point ${dp.id}: invalid slot \"${slot}\", pin \"${dp.address}\" or line \"${dp.line}\"`);\n}\nconst chip = `/dev/iotdin/extension/DI8O8-${slot}-gpiochip`;\n\n// accept true/false, 1/0, \"1\"/\"0\", \"true\"/\"false\", \"on\"/\"off\"\nlet v = command.value;\nif (typeof v === \"string\") v = v.trim().toLowerCase();\nlet state;\nif (v === true || v === 1 || v === \"1\" || v === \"true\" || v === \"on\") state = true;\nelse if (v === false || v === 0 || v === \"0\" || v === \"false\" || v === \"off\") state = false;\nelse return fail(\"ERROR_BRIDGE_COMMAND_CONFIG\", `Invalid value \"${command.value}\" for ${dp.id}`);\n\nconst physical = dp.invert ? !state : state;\nresponse.value = {\n    actual: (flow.get(\"bridge.image.metrics\") || {})[dp.id],\n    target: command.value\n};\n\n// v1: gpioset <chip> <line>=<0|1>   v2: gpioset -c <chip> -t0 <line>=<0|1> (-t0 = set and exit)\nconst value = physical ? 1 : 0;\nconst args = GPIOD_V2 ? `-c ${chip} -t0 ${line}=${value}` : `${chip} ${line}=${value}`;\nreturn [{\n    payload: args,\n    gpioArgs: args,\n    dataPoint: dp,\n    name: dp.id,\n    targetState: state,\n    response: response,\n    responseTopic: responseTopic\n}, null];\n",
            "outputs": 2,
            "timeout": 0,
            "noerr": 0,
            "initialize": "",
            "finalize": "",
            "libs": [],
            "x": 1000,
            "y": 1000,
            "wires": [
                [
                    "88flvp358dp0at3g",
                    "k5ly0bvlyuimeyei"
                ],
                [
                    "16igx9l4z0m2t7u9"
                ]
            ]
        },
