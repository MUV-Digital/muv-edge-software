            "name": "check return code",
            "func": "// exec return code output: anything other than 0 is a read failure\nif (msg.payload && msg.payload.code !== 0) {\n    node.error(`DI read failed for ${msg.name} (gpioget ${msg.gpioArgs}): rc=${msg.payload.code}`, msg);\n}\nreturn null;\n",
            "outputs": 0,
