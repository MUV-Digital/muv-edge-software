        {
            "id": "sb2ts8qxb5muaxvt",
            "type": "function",
            "z": "zmvla7av3iohil20",
            "name": "build DI read",
            "func": "// One gpioget call per DI8O8 module for all its digital inputs.\n// Data point convention (bridge.image.protocols):\n//   io      : \"DI\" (default) | \"DO\"  -> outputs are skipped, reading a DO line would turn it into an input\n//   address : pin 0..7  -> GPIO line = pin + DI_LINE_OFFSET (tab env, default 0)\n//   line    : optional explicit GPIO line override\n//   slot    : optional, otherwise controller.slot, default \"A\"\nconst DEFAULT_SLOT = (flow.get(\"bridge.image.controller\") || {}).slot || \"A\";\nconst DI_LINE_OFFSET = Number(env.get(\"DI_LINE_OFFSET\") ?? 0);\nconst GPIOD_V2 = env.get(\"GPIOD_V2\") === true;\n\nconst points = (flow.get(\"bridge.image.protocols\") || []).filter(dp =>\n    dp.type !== \"virtual\" && dp.type !== \"calculated\" &&\n    String(dp.io || \"DI\").toUpperCase() === \"DI\");\n\nconst bySlot = {};\nfor (const dp of points) {\n    const slot = String(dp.slot || DEFAULT_SLOT).toUpperCase();\n    const pin = Number(dp.address);\n    const line = dp.line !== undefined ? Number(dp.line) : pin + DI_LINE_OFFSET;\n    if (!/^[A-H]$/.test(slot) || !Number.isInteger(pin) || pin < 0 || pin > 7 || !Number.isInteger(line) || line < 0 || line > 63) {\n        node.warn(`Data point ${dp.id}: invalid slot \"${slot}\", pin \"${dp.address}\" or line \"${dp.line}\"`);\n        continue;\n    }\n    (bySlot[slot] = bySlot[slot] || []).push({ dataPoint: dp, line: line });\n}\n\nfor (const slot of Object.keys(bySlot)) {\n    const chip = `/dev/iotdin/extension/DI8O8-${slot}-gpiochip`;\n    const lines = bySlot[slot].map(p => p.line).join(\" \");\n    // v1: gpioget <chip> <lines...>   v2: gpioget -c <chip> --numeric <lines...>\n    const args = GPIOD_V2 ? `-c ${chip} --numeric ${lines}` : `${chip} ${lines}`;\n    node.send({ topic: slot, name: `DI8O8-${slot}`, points: bySlot[slot], gpioArgs: args, payload: args });\n}\nnode.done();\n",
